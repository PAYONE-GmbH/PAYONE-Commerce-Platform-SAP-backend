<?xml version="1.0" encoding="UTF-8"?>
<!--
    Backoffice editor for the non-secret PayoneConfiguration fields (checkout type,
    webhook URL, payment-product registry, authorization mode), plus read-only views
    of commerce cases, checkouts and transactions. Secrets are never editable here.
-->
<extensioninfo xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="extensioninfo.xsd">

    <extension name="payonepcpbackoffice"
               classprefix="Payonepcpbackoffice"
               abstractclassprefix="Generated"
               managername="PayonepcpbackofficeManager"
               managersuperclass="de.hybris.platform.jalo.extension.Extension"
               version="1.0.0">

        <!-- payonepcpcore supplies the PayoneConfiguration type being edited;
             backoffice supplies the cockpit-ng widget framework. -->
        <requires-extension name="payonepcpcore"/>
        <requires-extension name="payonepcpwebhook"/>
        <!-- Checkout editor Capture/Refund actions delegate to PayonePaymentOperationsFacade. -->
        <requires-extension name="payonepcpfacades"/>
        <requires-extension name="backoffice"/>

        <!-- Core module - generates model classes from items.xml -->
        <coremodule generated="true"
                    manager="com.payone.pcp.backoffice.jalo.PayonepcpbackofficeManager"
                    packageroot="com.payone.pcp.backoffice"/>

        <!-- Marks the backoffice/ source folder as a cockpit-ng module -->
        <meta key="backoffice-module" value="true"/>

    </extension>
</extensioninfo>
