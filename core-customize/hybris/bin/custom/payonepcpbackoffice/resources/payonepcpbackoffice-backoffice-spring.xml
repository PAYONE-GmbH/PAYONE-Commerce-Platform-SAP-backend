<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="payonepcpbackofficeService" class="com.payone.pcp.backoffice.services.PayonepcpbackofficeService">
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
	</bean>

	<bean id="payonepcpbackofficeLabelLocator" class="com.hybris.cockpitng.util.labels.ResourcesLabelLocator" scope="singleton" init-method="init" lazy-init="false">
